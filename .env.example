# Copy this file to .env and replace the Atlas URI with your own connection string.
# URL-encode special characters in the database username/password.
MONGODB_URI=mongodb+srv://YOUR_DATABASE_USER:YOUR_ENCODED_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=cna_academy
# Set this to your exact HTTPS website origin for production.
# APP_ORIGIN=https://cnatrainingacademy.org
API_PORT=3001
# Render uses its assigned PORT and binds to 0.0.0.0 automatically.
# Vercel: set the Render service's exact HTTPS origin.
# RENDER_API_URL=https://YOUR_SERVICE.onrender.com
# Resend email verification (server / Render only).
RESEND_API_KEY=YOUR_RESEND_API_KEY
RESEND_FROM=CNA Training Academy <verification@cnatrainingacademy.org>
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
OTP_SECRET=YOUR_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Authorized staff; these accounts still require password + email OTP.
ADMIN_EMAILS=sayflux04@gmail.com
# One-time administrator seed; choose a private password, never commit it.
# SEED_ADMIN_EMAIL=sayflux04@gmail.com
# SEED_ADMIN_PASSWORD=YOUR_PRIVATE_PASSWORD_AT_LEAST_12_CHARACTERS
